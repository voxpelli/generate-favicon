{
  "name": "@voxpelli/generate-favicon",
  "version": "1.1.1",
  "description": "CLI for generating favicons from SVG source",
  "homepage": "http://github.com/voxpelli/generate-favicon",
  "repository": {
    "type": "git",
    "url": "git://github.com/voxpelli/generate-favicon.git"
  },
  "keywords": [],
  "author": "Pelle Wessman <pelle@kodfabrik.se> (http://kodfabrik.se/)",
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "typescript": ">=5.9"
  },
  "bin": {
    "generate-favicon": "cli.js"
  },
  "type": "module",
  "files": [
    "cli.js",
    "lib/**/*.js"
  ],
  "scripts": {
    "check:installed-check": "installed-check",
    "check:knip": "knip",
    "check:lint": "eslint",
    "check:tsc": "tsc",
    "check:type-coverage": "type-coverage --detail --strict --at-least 99 --ignore-files 'test/*'",
    "check": "run-p check:*",
    "prepare": "husky",
    "test:mocha": "c8 --reporter=lcov --reporter=text mocha 'test/**/*.spec.js'",
    "test-ci": "run-s test:*",
    "test": "run-s check test:*"
  },
  "dependencies": {
    "@voxpelli/typed-utils": "^4.2.0",
    "color-string": "^1.9.1",
    "ico-endec": "^0.1.6",
    "peowly": "^1.3.3",
    "pony-cause": "^2.1.11",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/chai": "^4.3.20",
    "@types/color-string": "^1.5.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.17",
    "@voxpelli/eslint-config": "^24.0.1",
    "@voxpelli/tsconfig": "^16.2.1",
    "c8": "^11.0.0",
    "chai": "^4.5.0",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "installed-check": "^10.0.1",
    "knip": "^6.5.0",
    "mocha": "^11.1.0",
    "npm-run-all2": "^8.0.4",
    "type-coverage": "^2.29.7",
    "typescript": "~6.0.2",
    "validate-conventional-commit": "^1.0.4"
  }
}
